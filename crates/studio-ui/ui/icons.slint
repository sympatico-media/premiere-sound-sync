// Single-color line icons; tint them with `colorize`.
export global Icons {
    out property <image> plus: @image-url("icons/plus.svg");
    out property <image> folder: @image-url("icons/folder.svg");
    out property <image> film: @image-url("icons/film.svg");
    out property <image> wave: @image-url("icons/wave.svg");
    out property <image> file: @image-url("icons/file.svg");
    out property <image> chevron-down: @image-url("icons/chevron-down.svg");
    out property <image> close: @image-url("icons/close.svg");
    out property <image> link: @image-url("icons/link.svg");
    out property <image> cameras: @image-url("icons/cameras.svg");
    out property <image> alert: @image-url("icons/alert.svg");
    out property <image> check: @image-url("icons/check.svg");
    // Full-color illustrations.
    out property <image> project: @image-url("icons/project.svg");
    out property <image> project-new: @image-url("icons/project-new.svg");
}
